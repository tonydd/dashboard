# Copy to .env.compose.prod, then encrypt it with the other deployment secrets.
# Passwords should be URL-safe (for example: openssl rand -hex 24).
MYSQL_ROOT_PASSWORD=replace-with-openssl-rand-hex-24
MYSQL_DATABASE=symfony
MYSQL_USER=dashboard
MYSQL_PASSWORD=replace-with-a-different-openssl-rand-hex-24

# Loopback ports for the Apache reverse proxies.
PHP_BIND_PORT=9100
WEB_BIND_PORT=9101
# Camera signaling WebSocket (Apache proxies /camera-ws to this port).
CAM_WS_BIND_PORT=9102

# Optional host directory containing slideshow .jpg files.
# If omitted, Compose uses ./symfony/var/backgrounds from the deployment checkout.
# BACKGROUND_HOST_PATH=/absolute/path/to/backgrounds
APP_TIMEZONE=Europe/Paris
