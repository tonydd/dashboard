# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
THERMOR_API_TOKEN=test-thermor-token

# .env.local is ignored in the test environment, so the database must be
# redefined here: dedicated test database on the local Compose MySQL.
DATABASE_URL="mysql://root:root@db/symfony_test?serverVersion=8.0.39&charset=utf8"
