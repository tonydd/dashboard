# Template for the encrypted .env.production.vue file. Every VITE_* value is public in the browser bundle.
VITE_BASE_URL=/
VITE_ENABLE_STATS=false

VITE_SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
VITE_SPOTIFY_ACCOUNT_BASE_URL=https://accounts.spotify.com
VITE_SPOTIFY_CLIENT_ID=

VITE_GOOGLE_CALENDAR_IFRAME_URL=

VITE_OPENWEATHERMAP_API_URL=https://api.openweathermap.org/data/3.0/onecall
VITE_OPENWEATHERMAP_API_KEY=
VITE_OPENWEATHERMAP_LAT=
VITE_OPENWEATHERMAP_LON=
VITE_OPENWEATHERMAP_UNITS=metric
VITE_OPENWEATHERMAP_LANG=fr

VITE_API_BASE_URL=/api
VITE_FUEL_API_URL=/api/fuel
VITE_SOLAR_API_URL=/api/solar
VITE_WATER_HEATER_API_URL=/api/thermor
VITE_WATER_QUALITY_API_URL=/api/waterQuality
VITE_FUEL_API_STATION_ID=
VITE_FUEL_API_STATION_NAME=

VITE_DEFAULT_MESSAGE=Bonjour
VITE_BACKGROUND_URL=/api/background
VITE_BACKGROUND_TOKEN=

VITE_SOLAR_PANEL_REFRESH_INTERVAL=1 minute
VITE_FUEL_INFO_REFRESH_INTERVAL=6 hour
VITE_WATER_QUALITY_REFRESH_INTERVAL=12 hour
VITE_WATER_HEATER_REFRESH_INTERVAL=2 minute
VITE_WEATHER_REFRESH_INTERVAL=10 minute
VITE_CALENDAR_REFRESH_INTERVAL=5 minute
VITE_SPOTIFY_ACTIVE_REFRESH_INTERVAL=1 second
VITE_SPOTIFY_IDLE_REFRESH_INTERVAL=1 minute
