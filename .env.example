##### DOCKER COMPOSE #####
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=symfony
MYSQL_USER=dashboard
MYSQL_PASSWORD=dashboard
MYSQL_PORT=33061
BACKGROUND_HOST_PATH=./symfony/var/backgrounds
BACKGROUND_PATH=/srv/backgrounds
# Token appended to the external slideshow image URL, when required.
BACKGROUND_TOKEN=
APP_TIMEZONE=Europe/Paris
THERMOR_API_TOKEN=
# Public URL of the camera signaling WebSocket. In Docker dev, compose defaults to
# ws://{host}:8081 ({host} is replaced by the current hostname in the browser).
# Empty = same origin as the dashboard (wss://host/camera-ws, via the production Caddy router).
CAMERA_WS_URL=

##### SERVER-SIDE DASHBOARD INTEGRATIONS #####
# OpenWeatherMap credentials stay in the Symfony/PHP environment, never in browser assets.
OPENWEATHERMAP_API_URL=https://api.openweathermap.org/data/3.0/onecall
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_LAT=
OPENWEATHERMAP_LON=
OPENWEATHERMAP_UNITS=metric
OPENWEATHERMAP_LANG=fr
FUEL_API_STATION_NAME=
